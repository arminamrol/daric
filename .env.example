# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# --- Postgres (docker/compose.yml) ---
# Superuser created on first start of the Postgres container.
POSTGRES_USER=daric
POSTGRES_PASSWORD=daric
POSTGRES_DB=daric
# Host port Postgres is published on.
POSTGRES_PORT=5432

# Connection string the API uses. Must match the values above.
DATABASE_URL=postgres://daric:daric@localhost:5432/daric

# --- Mail (Mailpit in development) ---
# Host port of Mailpit's SMTP server.
MAILPIT_SMTP_PORT=1025
# Host port of Mailpit's web inbox: http://localhost:8025
MAILPIT_UI_PORT=8025

# SMTP server the API sends mail through. In development this is Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
# `true` for TLS from the start (usually port 465); otherwise STARTTLS when offered.
SMTP_SECURE=false
# SMTP login, if the server needs one (Mailpit does not).
# SMTP_USER=
# SMTP_PASSWORD=
# Sender address on outgoing mail.
MAIL_FROM="Daric <no-reply@daric.local>"
# Origin of the web app; verification and password-reset links point here.
APP_URL=http://localhost:5173

# --- API ---
# Port the API listens on.
PORT=3000
# Key that signs access tokens. Use a long random value outside development:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Token lifetimes in seconds (defaults: 15 minutes and 30 days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Requests per minute per client: all routes, and login/registration.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Requests per hour per client that send mail (password reset, verification resend).
MAIL_RATE_LIMIT_PER_HOUR=5
# Number of reverse proxies in front of the API (0 when exposed directly).
TRUST_PROXY=0
# Minutes between runs of the month-end Net Worth Snapshot job; 0 turns it off.
SNAPSHOT_JOB_INTERVAL_MINUTES=60

# --- Plans (ADR-0008) ---
# `true` makes Plans limit what Users may do. Off by default: a self-hosted server
# leaves every Entitlement unlimited and sells nothing.
BILLING_ENABLED=false
# Days of Plus every new User gets at sign-up.
TRIAL_DAYS=14
# Signed-in Devices per User on each Plan.
FREE_DEVICE_LIMIT=1
PLUS_DEVICE_LIMIT=3
# AI analyses per User per month on each Plan.
FREE_AI_ANALYSES_PER_MONTH=1
PLUS_AI_ANALYSES_PER_MONTH=30
# Price of one month of Plus, in rials. 3+ months are 5% off, 6+ 10%, and a year costs ten months.
PLUS_MONTHLY_PRICE_IRR=2000000
# Zarinpal merchant id (36 characters). Without one, buying Plus answers 503.
# ZARINPAL_MERCHANT_ID=
# `true` sends payments to Zarinpal's sandbox, where nothing is charged.
ZARINPAL_SANDBOX=false
LOG_LEVEL=info
