{
  "name": "@daric/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate-cli.ts"
  },
  "devDependencies": {
    "@daric/config": "workspace:*",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@daric/core": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  }
}
